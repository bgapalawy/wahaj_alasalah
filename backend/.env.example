# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# AWS — these now stay on the server only. Never prefix with VITE_ or expose to frontend.
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# DynamoDB table names — confirmed against the real AWS console for these three;
# swap in the real names for the rest if they differ.
DDB_VILLAS_TABLE=WajhaVillas
DDB_PLANNED_COSTS_TABLE=plannedCostsTable
DDB_ACTUAL_COSTS_TABLE=ActualCostsTable
DDB_PLANNED_DATES_TABLE=Planned_dates
DDB_ACTUAL_DATES_TABLE=Actual_dates
DDB_PLANNED_DATES_FINISH_TABLE=Planned_dates_Finish
DDB_SPECIAL_QUERY_TABLE=wajhaspecialquerytable
DDB_WAJHA_DATA_TABLE=wajha_project_data_table
DDB_INVOICE_TABLE=wajhaInvoicetable

# S3 — for the file-status uploads currently done client-side in left_click.js
S3_BUCKET_NAME=replace_me
