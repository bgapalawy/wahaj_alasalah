{
  "name": "shams_elgroub-backend",
  "version": "1.0.0",
  "description": "API layer for Shams_Elgroub — owns all AWS/DynamoDB/S3 access so credentials never reach the browser.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate:dry-run": "node scripts/migrate-to-postgres.js --dry-run",
    "migrate:write": "node scripts/migrate-to-postgres.js --write",
    "create-user": "node scripts/create-user.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
