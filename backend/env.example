# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Auth — everything except POST /api/auth/login requires a valid token
# signed with JWT_SECRET. Without this, the server won't start.
#
# Generate a real random secret rather than typing one — e.g. run this
# once and paste the result:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# No password goes here anymore — accounts are real rows in the `users`
# table (see db/schema-users.sql), created with:
#   npm run create-user -- <username> <password>

# AWS — these now stay on the server only. Never prefix with VITE_ or expose to frontend.
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# DynamoDB table names — confirmed against the real AWS console for these three;
# swap in the real names for the rest if they differ.
DDB_VILLAS_TABLE=WajhaVillas
DDB_PLANNED_COSTS_TABLE=plannedCostsTable
DDB_ACTUAL_COSTS_TABLE=ActualCostsTable
DDB_PLANNED_DATES_TABLE=Planned_dates
DDB_ACTUAL_DATES_TABLE=Actual_dates
DDB_PLANNED_DATES_FINISH_TABLE=Planned_dates_Finish
DDB_SPECIAL_QUERY_TABLE=wajhaspecialquerytable
DDB_WAJHA_DATA_TABLE=wajha_project_data_table
DDB_INVOICE_TABLE=wajhaInvoicetable

# S3 — for the file-status uploads currently done client-side in left_click.js
S3_BUCKET_NAME=replace_me

# Postgres (Neon) — the migration target. Get this from your Neon project
# dashboard: Connect > copy the connection string. Neon includes
# ?sslmode=require in the string by default, which is what you want.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
